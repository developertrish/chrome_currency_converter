{
  "manifest_version": 3,
  "name": "Currency Converter — Real-Time Prices",
  "version": "1.0.0",
  "description": "Detects prices on any webpage and shows a live conversion to your chosen currency.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://open.er-api.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Currency Converter"
  }
}
